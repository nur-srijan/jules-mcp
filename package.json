{
  "name": "jules-mcp",
  "version": "1.1.0",
  "description": "MCP server and Lead Architect Orchestrator skill bundle for the Google Jules asynchronous coding agent",
  "type": "module",
  "main": "dist/index.js",
  "author": "Nur Srijan",
  "license": "MIT",
  "homepage": "https://github.com/nur-srijan/jules-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/nur-srijan/jules-mcp.git"
  },
  "keywords": [
    "jules",
    "mcp",
    "model-context-protocol",
    "orchestrator",
    "agent-skills",
    "claude-code-plugin",
    "skills",
    "parallel-agents",
    "subagents"
  ],
  "skills": "./skills/",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "tunnel": "npx localtunnel --port 3000",
    "tunnel:cloudflared": "cloudflared tunnel --url http://localhost:3000"
  },
  "bin": {
    "jules-mcp": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "typescript": "^5.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
