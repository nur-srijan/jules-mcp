# Jules API Key (Generate at https://jules.google.com/settings#api)
JULES_API_KEY=your_jules_api_key_here

# Server port (default: 3000)
PORT=3000

# Security / OAuth Protection for Gemini & remote clients
# Set these to protect your server from unauthorized usage and abuse
MCP_CLIENT_ID=gemini
MCP_CLIENT_SECRET=your_secure_password_or_secret_here
